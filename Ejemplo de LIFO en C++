
#include <iostream>
#include <string>
using namespace std;

int main() {
    string pila[5];
    
    cout << "=== INGRESO DE LIBROS A LA PILA ===" << endl;

    for(int i = 0; i < 5; i++) {
        cout << "Ingrese nombre del libro " << i+1 << ": ";
        cin >> pila[i];
    }

    cout << "\nLibros ingresados en orden:" << endl;
    for(int i = 0; i < 5; i++) {
        cout << pila[i] << endl;
    }

    cout << "\nLibros retirados aplicando LIFO:" << endl;
    for(int i = 4; i >= 0; i--) {
        cout << pila[i] << endl;
    }

    return 0;
}
